<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:NotificationHistory.ViewModels" xmlns:model="clr-namespace:NotificationHistory.Core.Models;assembly=NotificationHistory.Core"
 x:Class="NotificationHistory.Views.NotificationsPage" x:DataType="vm:NotificationsViewModel" Title="Notification History">
 <ContentPage.ToolbarItems><ToolbarItem Text="Setup" Clicked="OnSetup" /><ToolbarItem Text="Settings" Clicked="OnSettings" /></ContentPage.ToolbarItems>
 <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,8" RowSpacing="8">
  <SearchBar Placeholder="Search your history" Text="{Binding Search}" TextChanged="OnSearch" />
  <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
   <Button x:Name="FavoriteButton" Text="All" FontSize="13" Clicked="OnFavoriteFilter" />
   <Button x:Name="SourceButton" Grid.Column="1" Text="All apps" FontSize="13" LineBreakMode="TailTruncation" Clicked="OnSource" />
   <Button x:Name="DateButton" Grid.Column="2" Text="Any date" FontSize="13" Clicked="OnDate" />
  </Grid>
  <DatePicker x:Name="FilterDate" Grid.Row="2" IsVisible="False" DateSelected="OnDateSelected" />
  <RefreshView Grid.Row="3" x:Name="Refresh" Refreshing="OnRefresh">
   <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="Single" SelectionChanged="OnSelected"
     RemainingItemsThreshold="12" RemainingItemsThresholdReached="OnLoadMore">
    <CollectionView.EmptyView><VerticalStackLayout Padding="24,60" Spacing="12"><Label Text="A little peace of mind" FontSize="24" HorizontalTextAlignment="Center" /><Label Text="Saved notifications will appear here. Set up a Shortcut to start capturing." HorizontalTextAlignment="Center" /></VerticalStackLayout></CollectionView.EmptyView>
    <CollectionView.GroupHeaderTemplate><DataTemplate x:DataType="vm:NotificationGroup"><Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#636366, Dark=#AEAEB2}" Padding="4,18,4,8" /></DataTemplate></CollectionView.GroupHeaderTemplate>
    <CollectionView.ItemTemplate><DataTemplate x:DataType="model:NotificationEntry">
     <Border Margin="0,0,0,8" Padding="16,12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">
      <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
       <Label Text="{Binding SourceDisplay}" FontSize="13" FontAttributes="Bold" TextColor="#087E8B" MaxLines="1" />
       <HorizontalStackLayout Grid.Column="1" Spacing="6"><Label Text="{Binding FavoriteDisplay}" TextColor="#D99000" /><Label Text="{Binding TimeDisplay}" FontSize="12" TextColor="{AppThemeBinding Light=#636366, Dark=#AEAEB2}" /></HorizontalStackLayout>
       <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TitleDisplay}" FontSize="17" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" />
       <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Preview}" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" />
      </Grid>
     </Border>
    </DataTemplate></CollectionView.ItemTemplate>
   </CollectionView>
  </RefreshView>
  <ActivityIndicator Grid.Row="3" IsRunning="{Binding Busy}" IsVisible="{Binding Busy}" Color="#087E8B" HorizontalOptions="Center" VerticalOptions="Start" InputTransparent="True" />
 </Grid>
</ContentPage>
