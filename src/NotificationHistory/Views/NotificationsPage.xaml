<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:NotificationHistory.ViewModels" xmlns:views="clr-namespace:NotificationHistory.Views"
 x:Class="NotificationHistory.Views.NotificationsPage" x:DataType="vm:NotificationsViewModel" Title="Notification History">
 <ContentPage.ToolbarItems><ToolbarItem Text="Apps" Clicked="OnApps" /><ToolbarItem Text="Settings" Clicked="OnSettings" /></ContentPage.ToolbarItems>
 <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,8" RowSpacing="8">
  <Border Style="{StaticResource InputBorderStyle}" Padding="14,4">
   <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
    <Grid WidthRequest="20" HeightRequest="20" VerticalOptions="Center" InputTransparent="True">
     <Ellipse WidthRequest="12" HeightRequest="12" HorizontalOptions="Start" VerticalOptions="Start"
       Stroke="{AppThemeBinding Light=#62626B, Dark=#A4A4AD}" StrokeThickness="1.8" />
     <Line X1="11" Y1="11" X2="17" Y2="17"
       Stroke="{AppThemeBinding Light=#62626B, Dark=#A4A4AD}" StrokeThickness="1.8" />
    </Grid>
    <Entry x:Name="HistorySearch" Grid.Column="1" Placeholder="Search your history" Text="{Binding Search}" TextChanged="OnSearch"
      BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1C1C1E, Dark=White}"
      PlaceholderColor="{AppThemeBinding Light=#62626B, Dark=#A4A4AD}" MinimumHeightRequest="44"
      ReturnType="Search" ClearButtonVisibility="WhileEditing" SemanticProperties.Description="Search notification history" />
   </Grid>
   <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSearchFieldTapped" /></Border.GestureRecognizers>
  </Border>
  <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
   <Button x:Name="FavoriteButton" Text="All" FontSize="13" Clicked="OnFavoriteFilter" />
   <Button x:Name="SourceButton" Grid.Column="1" Text="{Binding SelectedAppName}" FontSize="13" LineBreakMode="TailTruncation" Clicked="OnSource" />
   <Button x:Name="DateButton" Grid.Column="2" Text="Any date" FontSize="13" Clicked="OnDate" />
  </Grid>
  <ScrollView Grid.Row="2" x:Name="AppBadgeScroll" Orientation="Horizontal" IsVisible="{Binding HasAppBadges}" HorizontalScrollBarVisibility="Default">
   <HorizontalStackLayout x:Name="AppBadgeRow" Padding="4,2,4,8" Spacing="8" BindableLayout.ItemsSource="{Binding AppBadges}">
    <BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:AppBadgeModel">
     <views:AppBadgeView>
      <views:AppBadgeView.GestureRecognizers><TapGestureRecognizer Tapped="OnBadgeTapped" /></views:AppBadgeView.GestureRecognizers>
     </views:AppBadgeView>
    </DataTemplate></BindableLayout.ItemTemplate>
   </HorizontalStackLayout>
  </ScrollView>
  <Border x:Name="FilterDateField" Grid.Row="3" Style="{StaticResource InputBorderStyle}" Padding="14,4" IsVisible="False">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <DatePicker x:Name="FilterDate" DateSelected="OnDateSelected" BackgroundColor="Transparent" MinimumHeightRequest="48" TextColor="{AppThemeBinding Light=#1C1C1E, Dark=White}" />
    <Label Grid.Column="1" Text="⌄" FontSize="23" VerticalOptions="Center" InputTransparent="True" />
   </Grid>
   <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDateFieldTapped" /></Border.GestureRecognizers>
  </Border>
  <RefreshView Grid.Row="4" x:Name="Refresh" Refreshing="OnRefresh">
   <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None"
     RemainingItemsThreshold="12" RemainingItemsThresholdReached="OnLoadMore">
    <CollectionView.EmptyView><VerticalStackLayout Padding="24,60" Spacing="12"><Label Text="A little peace of mind" FontSize="24" HorizontalTextAlignment="Center" /><Label Text="{Binding EmptyMessage}" HorizontalTextAlignment="Center" /></VerticalStackLayout></CollectionView.EmptyView>
    <CollectionView.GroupHeaderTemplate><DataTemplate x:DataType="vm:NotificationGroup"><Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#636366, Dark=#AEAEB2}" Padding="12,18,16,8" /></DataTemplate></CollectionView.GroupHeaderTemplate>
    <CollectionView.ItemTemplate><DataTemplate x:DataType="vm:NotificationCardModel">
     <SwipeView Margin="8,0,12,12" BackgroundColor="Transparent" SwipeStarted="OnSwipeStarted" SwipeEnded="OnSwipeEnded">
      <SwipeView.RightItems>
       <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
        <SwipeItemView WidthRequest="112" Padding="8,0,0,0" BackgroundColor="Transparent"
          CommandParameter="{Binding Entry.Id}" Invoked="OnSwipeDelete"
          SemanticProperties.Description="Delete notification" SemanticProperties.Hint="Opens a deletion confirmation.">
         <Border BackgroundColor="#C43C35" StrokeThickness="0" Padding="12" InputTransparent="True">
          <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
          <Label Text="Delete" TextColor="White" FontSize="16" FontAttributes="Bold"
            HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
         </Border>
        </SwipeItemView>
       </SwipeItems>
      </SwipeView.RightItems>
      <views:NotificationCardView SemanticProperties.Hint="Tap to open notification. Swipe left to reveal Delete.">
       <views:NotificationCardView.GestureRecognizers><TapGestureRecognizer Tapped="OnCardTapped" /></views:NotificationCardView.GestureRecognizers>
      </views:NotificationCardView>
     </SwipeView>
    </DataTemplate></CollectionView.ItemTemplate>
   </CollectionView>
  </RefreshView>
  <ActivityIndicator Grid.Row="4" IsRunning="{Binding Busy}" IsVisible="{Binding Busy}" Color="#087E8B" HorizontalOptions="Center" VerticalOptions="Start" InputTransparent="True" />
 </Grid>
</ContentPage>
