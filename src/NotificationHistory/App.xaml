<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="NotificationHistory.App">
 <Application.Resources>
  <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
   <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2F2F7, Dark=#000000}" />
   <Setter Property="HideSoftInputOnTapped" Value="True" />
  </Style>
  <Style TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}" /></Style>
  <Style TargetType="Button"><Setter Property="BackgroundColor" Value="#087E8B" /><Setter Property="TextColor" Value="White" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="16,12" /></Style>
  <Style TargetType="Entry" ApplyToDerivedTypes="True">
   <Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1C1E, Dark=White}" />
   <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#62626B, Dark=#A4A4AD}" />
   <Setter Property="BackgroundColor" Value="Transparent" />
   <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
   <Setter Property="ReturnType" Value="Done" />
  </Style>
  <Style TargetType="Editor" ApplyToDerivedTypes="True">
   <Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1C1E, Dark=White}" />
   <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#62626B, Dark=#A4A4AD}" />
   <Setter Property="BackgroundColor" Value="Transparent" />
  </Style>
  <Style TargetType="CollectionView"><Setter Property="SelectionMode" Value="None" /></Style>
  <Style x:Key="InputBorderStyle" TargetType="Border">
   <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#202024}" />
   <Setter Property="Stroke" Value="{AppThemeBinding Light=#B7B7C2, Dark=#686873}" />
   <Setter Property="StrokeThickness" Value="1.5" /><Setter Property="MinimumHeightRequest" Value="52" />
   <Setter Property="Padding" Value="14" />
   <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="12" /></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
