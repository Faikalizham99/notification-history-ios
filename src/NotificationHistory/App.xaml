<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="NotificationHistory.App">
 <Application.Resources>
  <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2F2F7, Dark=#000000}" /></Style>
  <Style TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}" /></Style>
  <Style TargetType="Button"><Setter Property="BackgroundColor" Value="#087E8B" /><Setter Property="TextColor" Value="White" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="16,12" /></Style>
  <Style TargetType="SearchBar"><Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1C1E, Dark=White}" /></Style>
 </Application.Resources>
</Application>
